%%{init: {"theme": "neutral"}}%%
flowchart TB
  BIN["Binance public archive<br>data.binance.vision<br>about 870 USDT perpetuals"]
  subgraph GH["GitHub Actions"]
    direction LR
    LD["Load one day (reusable workflow)<br>list coins, download, SHA-256 check,<br>unzip, gzip, upload with retries"]
    HI["History (run once)<br>monthly 1-hour files since 2020,<br>one job per year"]
    RC["Recheck<br>the previous 7 days<br>against Binance"]
    TR["Transform<br>bronze pipeline, dbt source freshness,<br>dbt build, publish to MEDUSA"]
    LD --> RC --> TR
    HI --> TR
  end
  subgraph DBX["Databricks Free Edition: catalog market"]
    direction LR
    L[("landing<br>volume binance<br>date=YYYY-MM-DD and<br>month=YYYY-MM folders")]
    BR[("bronze<br>klines_1m, metrics, klines_1h<br>streaming tables")]
    SI[("silver<br>fct_candle_1m, fct_metrics_5m,<br>fct_candle_1h, hourly archive,<br>one hourly series since 2020, dim_coin")]
    GO[("gold<br>coin_daily, market_daily, data_health,<br>unusual_moves, hour_profile, coin_baseline,<br>intraday_events, event_evidence")]
    SE[("semantic<br>metric_definitions,<br>user_metric_definitions<br>every version kept")]
    L -->|"Auto Loader"| BR
    BR -->|"dbt incremental MERGE"| SI
    SI -->|"dbt"| GO
  end
  BIN --> LD
  BIN --> HI
  LD -->|"databricks fs cp"| L
  HI -->|"databricks fs cp"| L
  TR -.->|"runs"| BR
  TR -.->|"runs"| SI
  GO -.->|"daily copy of coin_baseline and event_evidence,<br>through a write-only endpoint"| WEB["MEDUSA on Cloudflare<br>D1: market_baseline, market_evidence,<br>market_metrics, market_user_metrics<br>KV: the scanner's ready-made answer"]
  SE -.->|"current versions, same publish"| WEB
  WEB --> PG["Markets page, in each browser<br>SQLite: the copy + Binance's live prices<br>every number calculated by the published SQL"]
  PG -->|"Save in a calculation window"| WEB
  WEB -->|"service principal, SQL Statement API,<br>one parameterized MERGE"| SE
