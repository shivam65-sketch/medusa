/*
  Strict-Transport-Security: max-age=31536000; includeSubDomains
  X-Content-Type-Options: nosniff
  Referrer-Policy: no-referrer
  X-Frame-Options: DENY
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=()
  Content-Security-Policy: default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src 'self' https://api.binance.com https://fapi.binance.com https://data.binance.vision wss://fstream.binance.com; manifest-src 'self'; frame-ancestors 'none'; base-uri 'none'; form-action 'self'

# MEDUSA Lab's Python engine (a background worker). WebAssembly needs 'wasm-unsafe-eval'; only this
# worker gets it, and it can't reach Binance or anything else outside MEDUSA. It also switches its
# own network access off once Python has loaded (see lab/py-worker.js).
/lab/py-worker.js
  ! Content-Security-Policy
  Content-Security-Policy: default-src 'self'; script-src 'self' 'wasm-unsafe-eval'; connect-src 'self'; base-uri 'none'

# Pyodide's files never change at a given version (the version is in the path), so browsers keep them.
/lab/pyodide/*
  Cache-Control: public, max-age=31536000, immutable
